{
  "name": "@olwiba/sync",
  "version": "0.2.1",
  "author": "Olwiba",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olwiba/olwibaSYNC"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.4",
    "typescript": "^5.7.2"
  },
  "bin": {
    "olwiba-sync": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts"
  },
  "description": "Check and sync @olwiba/* package versions against the live registry",
  "files": [
    "src"
  ],
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@olwiba/dx": "0.0.23"
  }
}
