{
  "name": "@olwiba/genesis-sync",
  "version": "0.1.2",
  "author": "Olwiba",
  "repository": {
    "type": "git",
    "url": "https://github.com/Olwiba/genesis-sync"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.5.4",
    "typescript": "^5.7.2"
  },
  "bin": {
    "genesis-sync": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts"
  },
  "description": "Inspect Genesis ecosystem package drift without writing downstream changes",
  "files": [
    "src"
  ],
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@olwiba/dx": "^0.0.10"
  }
}
